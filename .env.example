# Copy to .env and fill in. Never commit .env (it's in .gitignore).

# --- Telegram (required) ---
# Create a bot with @BotFather on Telegram -> /newbot -> copy the token here.
TELEGRAM_BOT_TOKEN=
# Your Telegram phone number, with country code. You verify once by tapping
# "Share my phone number" in the bot; only this number is accepted.
OWNER_PHONE=+91XXXXXXXXXX
# Optional: extra Telegram user ids allowed without phone verification (comma separated).
ALLOWED_USER_IDS=

# --- Claude AI (optional but recommended) --- https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max  (higher = smarter but slower/costlier)
CLAUDE_EFFORT=medium
CLAUDE_WEB_SEARCH=true
HISTORY_TURNS=20

# --- MetaTrader 5 / Exness (Windows only) ---
MT5_ENABLED=true
# Leave login blank to use whatever account the open MT5 terminal is logged into.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial
# Full path to terminal64.exe if MT5 isn't the default install.
MT5_PATH=
# Exness Standard accounts use an "m" suffix (EURUSDm); the bot tries common suffixes automatically.
MT5_SYMBOL_SUFFIX=
# Safety: trading is only allowed on DEMO accounts unless this is true.
MT5_ALLOW_LIVE=false
MT5_MAX_LOT=1.0

# --- Misc ---
TIMEZONE=Asia/Kolkata
DAILY_REPORT_TIME=08:00
ALERT_INTERVAL_SEC=30
BATTERY_WATCH=true
# Allows /sh (run commands on the host) and /screenshot. Only enable if you understand the risk.
ENABLE_REMOTE_CONTROL=false
DATA_DIR=data
